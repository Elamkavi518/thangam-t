# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# DB_DIALECT: "postgres" for production, "sqlite" for zero-install local development
DB_DIALECT=postgres
DATABASE_URL=postgres://goldwise_user:changeme@localhost:5432/goldwise
# Used only when DB_DIALECT=sqlite
SQLITE_STORAGE=./data/dev.sqlite

# ---- Auth / JWT ----
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Admin bootstrap (used only by the one-time seed script) ----
ADMIN_EMAIL=admin@goldwise.app
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Elamkavi S

# ---- OTP / Email / SMS providers ----
# Without real credentials, OTPs and emails are logged to the server console instead of
# actually being sent — this is clearly logged as DEV MODE so it is never mistaken for real delivery.
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Thangam <no-reply@thangam.app>"

SMS_PROVIDER=console
# If SMS_PROVIDER=twilio, fill these in:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Live gold rate provider ----
# GOLD_RATE_PROVIDER options: "goldapi" (needs GOLDAPI_KEY) or "metals-dev" (no key, best-effort)
GOLD_RATE_PROVIDER=metals-dev
GOLDAPI_KEY=
GOLD_RATE_POLL_MINUTES=5
GOLD_RATE_CURRENCY=INR

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
